<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.voice-input.client</string>

    <!-- launchd 直接跑 python -m client（不经 App bundle）。
         关键结论（2026-09-21 排查确认）：
           - 辅助功能授权授给 python 解释器本身即可，信任生效；
           - 经 App bundle(open/-a) 启动会让 NSStatusItem 菜单栏图标不可见
             （accessory 上下文问题）——所以直跑 python 最稳，图标+F9 都正常。
         唯一代价：python 解释器路径变化时要重新在辅助功能里授权。 -->
    <key>ProgramArguments</key>
    <array>
        <string>@PY@</string>
        <string>-u</string>
        <string>-m</string>
        <string>client</string>
    </array>

    <key>WorkingDirectory</key>
    <string>@ROOT@</string>

    <!-- 登录后自动启动；崩溃自动拉起（间隔≥10s） -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>@HOME@/Library/Logs/voice-input.log</string>
    <key>StandardErrorPath</key>
    <string>@HOME@/Library/Logs/voice-input.log</string>
</dict>
</plist>
